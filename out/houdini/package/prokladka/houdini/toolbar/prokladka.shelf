<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- PROKLADKA shelf — FBX bridge Blender <-> Maya <-> Houdini <-> UE.
       Loaded automatically from the Houdini package (packages/prokladka.json).
       Panel = full UI; other buttons = one-click actions on the active SOP/LOP. -->

  <tool name="prokladka_launch" label="PROKLADKA" icon="plk_panel">
    <script scriptType="python"><![CDATA[import prokladka
prokladka.launch()]]></script>
  </tool>

  <tool name="prokladka_export_fbx" label="Export FBX" icon="plk_fbx">
    <script scriptType="python"><![CDATA[import prokladka
try:
    path = prokladka.export_current("fbx")
    if path:
        hou.ui.setStatusMessage("PROKLADKA: " + path)
    else:
        hou.ui.displayMessage("PROKLADKA: export failed (see Houdini Console)")
except Exception as e:
    hou.ui.displayMessage("PROKLADKA FBX export:\n" + str(e))]]></script>
  </tool>

  <tool name="prokladka_export_vdb" label="Export VDB" icon="plk_vdb">
    <script scriptType="python"><![CDATA[import prokladka
try:
