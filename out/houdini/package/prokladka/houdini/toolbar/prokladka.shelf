  </tool>

  <tool name="prokladka_import" label="Import Bridge" icon="plk_import">
    <script scriptType="python"><![CDATA[import prokladka
recents = prokladka.read_recent_files()
if not recents:
    hou.ui.displayMessage("PROKLADKA: no recent exports (bridge_last.json is empty).\nExport from Blender/Maya first.")
else:
    if len(recents) == 1:
        picked = [0]
    else:
        sel = hou.ui.selectFromList(recents, default_choice=0,
                                    title="PROKLADKA Import Bridge",
                                    message="Choose a file to import:")
        picked = list(sel)
        if not picked:
            hou.ui.setStatusMessage("PROKLADKA: import cancelled")
            return
    node = prokladka.import_file(recents[picked[0]])
    if node:
        imports = hou.node("/obj/prokladka_imports")
        if imports:
            imports.setSelected(True, clear_all_selected=True)
        hou.ui.setStatusMessage("PROKLADKA: imported " + node.path())]]></script>
  </tool>

  <tool name="prokladka_naming" label="Apply Naming" icon="plk_naming">
    <script scriptType="python"><![CDATA[import prokladka
try:
    node = prokladka.get_active_sop()
except Exception:
    node = None
if node is None:
    hou.ui.displayMessage("PROKLADKA: no geometry found.
Select a SOP node or an /obj geometry first.")
else:
    n = prokladka.apply_hou_naming(node)
    hou.ui.setStatusMessage("PROKLADKA: renamed {} nodes".format(n))]]></script>
  </tool>

  <toolshelf name="prokladka" label="PROKLADKA">
    <memberTool name="prokladka_launch"/>
    <memberTool name="prokladka_export_fbx"/>
    <memberTool name="prokladka_export_vdb"/>
    <memberTool name="prokladka_export_abc"/>
    <memberTool name="prokladka_export_usd"/>
    <memberTool name="prokladka_import"/>
    <memberTool name="prokladka_naming"/>
  </toolshelf>
</shelfDocument>
