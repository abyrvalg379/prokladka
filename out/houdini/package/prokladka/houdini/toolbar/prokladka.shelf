<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- PROKLADKA shelf - FBX bridge Blender <-> Maya <-> Houdini <-> UE -->

  <tool name="prokladka_launch" label="PROKLADKA" icon="plk_panel">
    <script scriptType="python"><![CDATA[import prokladka
prokladka.launch()
]]></script>
  </tool>
  <tool name="prokladka_export_fbx" label="Export FBX" icon="plk_fbx">
    <script scriptType="python"><![CDATA[import prokladka
try:
    path = prokladka.export_current("fbx")
    if path:
        hou.ui.setStatusMessage("PROKLADKA: " + path)
except Exception as e:
    hou.ui.displayMessage("PROKLADKA FBX export: " + str(e))
]]></script>
  </tool>
  <tool name="prokladka_export_vdb" label="Export VDB" icon="plk_vdb">
    <script scriptType="python"><![CDATA[import prokladka
try:
    path = prokladka.export_current("vdb")
    if path:
        hou.ui.setStatusMessage("PROKLADKA: " + path)
except Exception as e:
    hou.ui.displayMessage("PROKLADKA VDB export: " + str(e))
]]></script>
  </tool>
  <tool name="prokladka_export_abc" label="Export Alembic" icon="plk_abc">
    <script scriptType="python"><![CDATA[import prokladka
try:
    path = prokladka.export_current("alembic")
    if path:
        hou.ui.setStatusMessage("PROKLADKA: " + path)
except Exception as e:
    hou.ui.displayMessage("PROKLADKA Alembic export: " + str(e))
]]></script>
  </tool>
  <tool name="prokladka_export_usd" label="Export USD" icon="plk_usd">
    <script scriptType="python"><![CDATA[import prokladka
try:
    path = prokladka.export_current("usd")
    if path:
        hou.ui.setStatusMessage("PROKLADKA: " + path)
except Exception as e:
    hou.ui.displayMessage("PROKLADKA USD export: " + str(e))
]]></script>
  </tool>
  <tool name="prokladka_import" label="Import Bridge" icon="plk_import">
    <script scriptType="python"><![CDATA[import prokladka
recents = prokladka.read_recent_files()
if not recents:
    hou.ui.displayMessage("PROKLADKA: no recent exports (bridge_last.json is empty). Export from Blender/Maya first.")
else:
    if len(recents) == 1:
        picked = 0
    else:
        try:
            sel = hou.ui.selectFromList(recents, title="PROKLADKA Import Bridge", message="Choose a file to import:")
        except Exception:
            sel = (0,)
        picked = sel[0] if sel else None
    if picked is None:
        hou.ui.setStatusMessage("PROKLADKA: import cancelled")
    else:
        node = prokladka.import_file(recents[picked])
        if node:
            imports = hou.node("/obj/prokladka_imports")
            if imports:
                imports.setSelected(True, clear_all_selected=True)
            hou.ui.setStatusMessage("PROKLADKA: imported " + node.path())
]]></script>
  </tool>
  <tool name="prokladka_naming" label="Apply Naming" icon="plk_naming">
    <script scriptType="python"><![CDATA[import prokladka
try:
    node = prokladka.get_active_sop()
except Exception:
    node = None
if node is None:
    hou.ui.displayMessage("PROKLADKA: no geometry found. Select a SOP node or an /obj geometry first.")
else:
    n = prokladka.apply_hou_naming(node)
    hou.ui.setStatusMessage("PROKLADKA: renamed " + str(n) + " nodes")
]]></script>
  </tool>
  <tool name="prokladka_history" label="Export History" icon="plk_history">
    <script scriptType="python"><![CDATA[import prokladka
hou.ui.displayMessage(prokladka.recent_history_report(), title="PROKLADKA Export History")]]></script>
  </tool>

  <tool name="prokladka_clear" label="Clear History" icon="plk_clear">
    <script scriptType="python"><![CDATA[import prokladka
ret = hou.ui.displayMessage("Clear export history? (bridge_last.json)", buttons=("Clear", "Cancel"))
if ret == 0:
    prokladka.clear_recent_json()
    hou.ui.setStatusMessage("PROKLADKA: recent history cleared")]]></script>
  </tool>

  <toolshelf name="prokladka" label="PROKLADKA">
    <memberTool name="prokladka_launch"/>
    <memberTool name="prokladka_export_fbx"/>
    <memberTool name="prokladka_export_vdb"/>
    <memberTool name="prokladka_export_abc"/>
    <memberTool name="prokladka_export_usd"/>
    <memberTool name="prokladka_import"/>
    <memberTool name="prokladka_naming"/>
    <memberTool name="prokladka_clear"/>
    <memberTool name="prokladka_history"/>
  </toolshelf>
</shelfDocument>
